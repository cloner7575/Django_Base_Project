DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SITE_NAME=محصولات خانگی محفل
DJANGO_LANGUAGE_CODE=fa
DJANGO_TEXT_DIRECTION=rtl
DJANGO_TIME_ZONE=Asia/Tehran
DJANGO_LOG_LEVEL=INFO
DJANGO_CURRENCY_LABEL=تومان
DJANGO_USE_JALALI=true
DATABASE_URL=postgres://mahfel:mahfel@localhost:5432/mahfel

# Zarinpal sandbox (test merchant id from zarinpal.com panel)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:8000/shop/payment/callback/

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
