# Copy to .env. Never commit .env.
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Product identity and locale
DJANGO_SITE_NAME=محمدرضا زارع
DJANGO_LANGUAGE_CODE=fa
# Comma separated; only set when the product really is multilingual.
DJANGO_LANGUAGES=fa,en
# Leave empty to derive rtl/ltr from the active language.
DJANGO_TEXT_DIRECTION=
DJANGO_TIME_ZONE=Asia/Tehran

# Data
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_DB_CONN_MAX_AGE=60
# Enables the Redis cache backend (needs the redis package installed).
REDIS_URL=

# Email — development defaults to the console backend.
DJANGO_EMAIL_BACKEND=
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false

# API throttling (DRF)
DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=600/min

# Logging
DJANGO_LOG_LEVEL=INFO
DJANGO_APP_LOG_LEVEL=INFO
DJANGO_LOG_SQL=false

# Production only
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_ADMIN_EMAILS=
